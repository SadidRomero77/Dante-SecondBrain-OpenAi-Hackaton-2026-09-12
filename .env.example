# ---- OpenAI (obligatorio) ----
OPENAI_API_KEY=sk-...

# Modelos. Confirmar los IDs en el dashboard antes de dar por hecho que existen.
DANTE_MODELO_VOZ=gpt-realtime-2
DANTE_MODELO_TEXTO=gpt-5.6-terra
DANTE_MODELO_EMBEDDINGS=text-embedding-3-small
DANTE_VOZ=marin

# ---- Transporte ----
# usb | wifi | auto
DANTE_TRANSPORTE=auto
# Puerto serie del aparato. En Windows: COM3, COM4...  Vacio = autodetectar.
DANTE_PUERTO_SERIE=
# Puerto donde el servidor escucha al aparato por WiFi
DANTE_PUERTO_WS=8765

# ---- Opcionales ----
# Indice de camara de OpenCV. Vacio = sin vision.
DANTE_CAMARA=
# Exa: busqueda web pensada para agentes. Llave en https://dashboard.exa.ai
# Sin ella, la busqueda cae al buscador de OpenAI y funciona igual.
EXA_API_KEY=
OPENROUTER_API_KEY=

# ---- Datos ----
DANTE_DB=data/dante.db
