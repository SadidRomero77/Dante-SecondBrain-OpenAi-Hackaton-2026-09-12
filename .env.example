# ---- OpenAI (obligatorio) ----
OPENAI_API_KEY=sk-...

# Modelos. Confirmar los IDs en el dashboard antes de dar por hecho que existen.
DANTE_MODELO_VOZ=gpt-realtime-2
DANTE_MODELO_TEXTO=gpt-5.6-terra
DANTE_MODELO_EMBEDDINGS=text-embedding-3-small
DANTE_VOZ=marin

# ---- Transporte ----
# usb | wifi | auto
DANTE_TRANSPORTE=auto
# Puerto serie del aparato. En Windows: COM3, COM4...  Vacio = autodetectar.
DANTE_PUERTO_SERIE=
# Puerto donde el servidor escucha al aparato por WiFi
# Si esta ocupado, busca el siguiente libre solo.
DANTE_PUERTO_WS=8770

# ---- Opcionales ----
# Indice de camara de OpenCV. Vacio = sin vision.
DANTE_CAMARA=
# Exa: busqueda web pensada para agentes. Llave en https://dashboard.exa.ai
# Sin ella, la busqueda cae al buscador de OpenAI y funciona igual.
EXA_API_KEY=
OPENROUTER_API_KEY=

# ---- Auth0 (opcional) ----
# Solo hace falta si el portal va a salir de 127.0.0.1. Sin esto queda abierto,
# que es lo correcto cuando solo lo ve tu maquina.
# Crea una "Regular Web Application" en https://manage.auth0.com y habilita
# Google. En Allowed Callback URLs pon http://127.0.0.1:8800/callback
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Correos que pueden entrar, separados por coma. Vacio = cualquiera con cuenta.
AUTH0_CORREOS=

# ---- Trigger.dev (opcional) ----
# Para lo que sale de la casa: el resumen semanal a la familia y el aviso de
# que algo no se confirmo. Los recordatorios que Dante dice en voz alta son
# locales; la nube no puede llamar a tu maquina.
# Llaves en https://cloud.trigger.dev -> tu proyecto -> API Keys
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# A donde va el resumen semanal
TRIGGER_CORREO_FAMILIA=
# Trigger.dev no manda correos por si mismo. Con esto los manda de verdad;
# sin esto la tarea deja el texto listo y visible en el panel de Trigger.
RESEND_API_KEY=
RESEND_REMITENTE=

# ---- Datos ----
DANTE_DB=data/dante.db
